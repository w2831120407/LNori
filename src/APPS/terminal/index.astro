---
// ═══════════════════════════════════════════════════
// Terminal 终端应用 — Astro 封装组件
// 使用 Python 后端实现真正的命令执行
// 通过 WebSocket 连接到 python_apps/framework.py
// ═══════════════════════════════════════════════════

// 导入终端客户端库
const WS_URL = 'ws://localhost:8765';
---

<div class="nori-app nori-app-terminal" data-app="terminal">
  <div id="terminal-root" class="nori-app-root">
    <div class="terminal-container" style="width:100%;height:100%;margin:0;">
      <div id="terminal-output" style="font-family:'IBM Plex Mono','Courier New',monospace;font-size:14px;padding:10px;color:#d4d4d4;background:#1e1e1e;height:calc(100% - 40px);overflow-y:auto;white-space:pre-wrap;"></div>
      <div class="terminal-input-line" style="display:flex;padding:10px;background:#1e1e1e;border-top:1px solid #333;">
        <span style="color:#23d18b;margin-right:8px;">$</span>
        <input 
          type="text" 
          id="terminal-input" 
          placeholder="输入命令 (help 查看帮助)..."
          style="flex:1;background:transparent;border:none;color:#d4d4d4;font-family:'IBM Plex Mono','Courier New',monospace;font-size:14px;outline:none;"
          autocomplete="off"
          autofocus
        />
      </div>
    </div>
  </div>
</div>

<script>
  // Terminal 应用逻辑
  (function() {
    const WS_URL = 'ws://localhost:8765';
    let ws = null;
    let connected = false;
    let commandHistory = [];
    let historyIndex = -1;
    
    const outputEl = document.getElementById('terminal-output');
    const inputEl = document.getElementById('terminal-input');
    
    function print(text, className = '') {
      const line = document.createElement('div');
      line.textContent = text;
      if (className) line.className = className;
      outputEl.appendChild(line);
      outputEl.scrollTop = outputEl.scrollHeight;
    }
    
    function clearScreen() {
      outputEl.innerHTML = '';
    }
    
    function connect() {
      try {
        ws = new WebSocket(WS_URL);
        
        ws.onopen = () => {
          connected = true;
          print('NoriOS Terminal v2.0 (Python Backend)', 'welcome');
          print('Connected to Python framework at ' + WS_URL, 'info');
          print('Type \"help\" for available commands.', 'info');
          print('');
        };
        
        ws.onerror = (error) => {
          connected = false;
          print('Error: Cannot connect to Python backend. Make sure framework.py is running.', 'error');
          print('Run: cd /workspace/python_apps && python3 framework.py', 'error');
        };
        
        ws.onclose = () => {
          connected = false;
          print('Disconnected from Python backend.', 'warning');
        };
        
        ws.onmessage = (event) => {
          const data = JSON.parse(event.data);
          handleResponse(data);
        };
      } catch (e) {
        print('Error creating WebSocket: ' + e.message, 'error');
      }
    }
    
    function handleResponse(data) {
      if (data.type === 'response') {
        const result = data.result;
        
        if (result.action === 'clear_screen') {
          clearScreen();
          return;
        }
        
        if (result.action === 'close_terminal') {
          print('Goodbye!', 'info');
          if (ws) ws.close();
          return;
        }
        
        if (result.output) {
          print(result.output);
        } else if (result.stdout) {
          print(result.stdout);
          if (result.stderr) {
            print(result.stderr, 'error');
          }
        } else if (result.error) {
          print('Error: ' + result.error, 'error');
        }
      } else if (data.type === 'reload') {
        print('[HMR] Application reloading...', 'warning');
      }
    }
    
    function executeCommand(command) {
      const trimmed = command.trim();
      
      if (!trimmed) return;
      
      // 添加到历史
      commandHistory.push(trimmed);
      historyIndex = commandHistory.length;
      
      // 显示命令
      print('$ ' + trimmed, 'command');
      
      if (!connected) {
        print('Not connected to backend. Attempting to reconnect...', 'error');
        connect();
        return;
      }
      
      // 解析命令和参数
      const parts = trimmed.split(/\s+/);
      const cmd = parts[0];
      const args = parts.slice(1);
      
      // 发送请求到 Python 后端
      ws.send(JSON.stringify({
        app_id: 'terminal',
        action: 'execute',
        params: {
          command: cmd,
          args: args
        }
      }));
    }
    
    // 事件监听
    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const command = inputEl.value;
        inputEl.value = '';
        executeCommand(command);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          inputEl.value = commandHistory[historyIndex] || '';
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          inputEl.value = commandHistory[historyIndex] || '';
        } else {
          historyIndex = commandHistory.length;
          inputEl.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        // TODO: 自动补全
      } else if (e.ctrlKey && e.key === 'c') {
        // Ctrl+C 中断
        if (ws && connected) {
          ws.send(JSON.stringify({
            app_id: 'terminal',
            action: 'interrupt',
            params: {}
          }));
        }
      } else if (e.ctrlKey && e.key === 'l') {
        e.preventDefault();
        clearScreen();
      }
    });
    
    // 保持焦点
    outputEl.addEventListener('click', () => {
      inputEl.focus();
    });
    
    // 初始化连接
    connect();
    
    // 暴露全局函数供调试
    window.terminalApp = {
      connect,
      executeCommand,
      clearScreen,
      print
    };
  })();
</script>

<style>
  .nori-app-terminal {
    width: 100%;
    height: 100%;
  }
  
  .terminal-container {
    display: flex;
    flex-direction: column;
    background: #1e1e1e;
    border-radius: 8px;
    overflow: hidden;
  }
  
  #terminal-output {
    flex: 1;
    overflow-y: auto;
  }
  
  #terminal-output::-webkit-scrollbar {
    width: 8px;
  }
  
  #terminal-output::-webkit-scrollbar-track {
    background: #1e1e1e;
  }
  
  #terminal-output::-webkit-scrollbar-thumb {
    background: #444;
    border-radius: 4px;
  }
  
  .welcome { color: #3b8eea; }
  .info { color: #888; }
  .error { color: #f14c4c; }
  .warning { color: #f5f543; }
  .command { color: #23d18b; margin-top: 8px; }
  
  .terminal-input-line input:focus {
    box-shadow: none;
  }
</style>